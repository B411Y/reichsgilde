<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Automatische Tests für den Simulationskern.
    Bewusst ohne Test-Framework: ein kleines Konsolenprogramm, das jede
    Prüfung ausführt und das Ergebnis anzeigt. Start im Terminal (Ordner reichsgilde): dotnet run mit Projekt tests/Reichsgilde.Core.Tests (siehe README)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Reichsgilde.Core\Reichsgilde.Core.csproj" />
    <!-- Das Kartenskript (Stadtskripte, Schreiben mit Schreibschutz, Vorschau) – KartenbauTests.cs -->
    <ProjectReference Include="..\..\tools\Kartenbau\Kartenbau.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Die Erkennung der Haushofmeister-Ansagen liegt im Spielordner, kennt aber Godot nicht – so lässt sie sich mit echten Kernmeldungen prüfen (AnsagenErkennungTests.cs) -->
    <Compile Include="..\..\game\scripts\KlangAnsagenErkennung.cs" Link="Ansagen\KlangAnsagenErkennung.cs" />
    <!-- Die Zuordnung der Textmeldungen zu Arten und Stufen (Benachrichtigungen Stufe 1) kennt ebenfalls kein Godot – MeldungsordnungTests.cs -->
    <Compile Include="..\..\game\scripts\Meldungsordnung.cs" Link="Ansagen\Meldungsordnung.cs" />
    <!-- Was man Arbeitern im Innenraum ansieht (Stufe, Volk, Geschlecht, Haar; Personal PR #224) – ArbeitertrachtTests.cs -->
    <Compile Include="..\..\game\scripts\Arbeitertracht.cs" Link="Arbeitertracht\Arbeitertracht.cs" />
    <!-- Die festen Geschwindigkeiten von Figuren und Karren (Gehtempo, Karrentempo, Fahrprofil, Karrenzug) – GehtempoTests.cs -->
    <Compile Include="..\..\game\scripts\Gehtempo.cs" Link="Gehtempo\Gehtempo.cs" />
    <!-- Zäune der Umlandstellen als Kisten der Ego-Perspektive (Zaun blockiert, Tor und Lücke offen) – EgoZaunTests.cs -->
    <Compile Include="..\..\game\scripts\EgoZaun.cs" Link="Gehtempo\EgoZaun.cs" />
    <Compile Include="..\..\game\scripts\Taschendiebgang.cs" Link="Gehtempo\Taschendiebgang.cs" />
    <!-- Einbruch und Banden bei Nacht (Wachen und Diebe, Paket P4) – NachtgangTests.cs -->
    <Compile Include="..\..\game\scripts\Nachtgang.cs" Link="Gehtempo\Nachtgang.cs" />
    <!-- Diebe weichen der Streife aus (Fenster und Bahn, nur Bild) – AusweichgangTests.cs -->
    <Compile Include="..\..\game\scripts\Ausweichgang.cs" Link="Gehtempo\Ausweichgang.cs" />
    <!-- Wahl der Streifenrunde (Wachen und Diebe, Paket P5) – StreifengangTests.cs -->
    <Compile Include="..\..\game\scripts\Streifengang.cs" Link="Gehtempo\Streifengang.cs" />
    <!-- Die Marktrunde der Streife (Haltepunkte um den Platz, Mindestlänge) – StreifeMarktrundeTests.cs -->
    <Compile Include="..\..\game\scripts\Marktrunde.cs" Link="Gehtempo\Marktrunde.cs" />
    <!-- Die Spuren der Passanten (Rechtsverkehr, Schwanken, weiche Übergänge) – PassantenspurTests.cs -->
    <Compile Include="..\..\game\scripts\Passantenspur.cs" Link="Gehtempo\Passantenspur.cs" />
    <!-- Ausweichen der Passanten (Schicht 4) und ihr Einstieg auf das nächste Wegstück – PassantenausweichenTests.cs, PassantenwegeTests.cs -->
    <Compile Include="..\..\game\scripts\Passantenausweichen.cs" Link="Gehtempo\Passantenausweichen.cs" />
    <Compile Include="..\..\game\scripts\Wegeinstieg.cs" Link="Gehtempo\Wegeinstieg.cs" />
    <!-- Markt v3 der Passanten: freie Fläche des Platzes und Bummeln von Ziel zu Ziel – MarktflaecheTests.cs, MarktbummelTests.cs -->
    <Compile Include="..\..\game\scripts\Marktflaeche.cs" Link="Gehtempo\Marktflaeche.cs" />
    <Compile Include="..\..\game\scripts\Marktbummel.cs" Link="Gehtempo\Marktbummel.cs" />
    <!-- Die Rechnung der Umgebungsklänge und der Menschen dahinter (Ton Schritt 4) kennt ebenfalls kein Godot – KlangUmgebungTests.cs -->
    <Compile Include="..\..\game\scripts\KlangUmgebungModell.cs" Link="Umgebung\KlangUmgebungModell.cs" />
    <Compile Include="..\..\game\scripts\KlangGlockenModell.cs" Link="Umgebung\KlangGlockenModell.cs" />
    <Compile Include="..\..\game\scripts\KlangStadtlebenModell.cs" Link="Umgebung\KlangStadtlebenModell.cs" />
    <Compile Include="..\..\game\scripts\KlangStadtlebenKern.cs" Link="Umgebung\KlangStadtlebenKern.cs" />
    <Compile Include="..\..\game\scripts\KlangUmweltModell.cs" Link="Umgebung\KlangUmweltModell.cs" />
    <!-- Die Rechnung der dynamischen Musik kennt kein Godot – MusikTests.cs -->
    <Compile Include="..\..\game\scripts\MusikModell.cs" Link="Musik\MusikModell.cs" />
    <!-- Ablauf, Hysterese und Neigung des 3D-Handschuh-Zeigers (Haltungen, Clip-Reihenfolge, FPS-Rückfall) kennen kein Godot – HandschuhModellTests.cs -->
    <Compile Include="..\..\game\scripts\HandschuhModell.cs" Link="Handschuh\HandschuhModell.cs" />
  </ItemGroup>
</Project>
