; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Reichsgilde"
config/description="Wirtschaftssimulation im spätmittelalterlichen Heiligen Römischen Reich – im Stil von „Die Gilde“."
run/main_scene="res://scenes/Hauptmenue.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/project_settings_override="user://grafikschnittstelle.cfg"

[autoload]

Fenster="*res://scripts/Fenster.cs"
Tooltips="*res://scripts/Tooltips.cs"
KlangDienst="*res://scripts/KlangDienst.cs"
KlicktestTreiber="*res://scripts/KlicktestTreiber.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[gui]

; Der eingebaute Tooltip ist aus: Tooltips.cs (Autoload) zeigt sie, mit Festheften und Verweisen
timers/tooltip_delay_sec=100000.0

[dotnet]

project/assembly_name="Reichsgilde"
project/solution_directory="../"

[shader_globals]

wind_richtung={
"type": "vec2",
"value": Vector2(1, 0.4)
}
wind_staerke={
"type": "float",
"value": 0.5
}
wetter_naesse={
"type": "float",
"value": 0.0
}
wetter_regen={
"type": "float",
"value": 0.0
}
wetter_rinn={
"type": "float",
"value": 0.0
}
wetter_schnee={
"type": "float",
"value": 0.0
}
wetter_dach={
"type": "float",
"value": 0.0
}
wetter_flaechen={
"type": "float",
"value": 1.0
}
wetter_wind={
"type": "float",
"value": 0.25
}
wellen_seegang={
"type": "float",
"value": 0.25
}
boden_pom={
"type": "float",
"value": 0.0
}
boden_blick={
"type": "vec3",
"value": Vector3(0, 0.8, 0.6)
}
wetter_himmel={
"type": "vec3",
"value": Vector3(0.3, 0.42, 0.6)
}
jahreszeit_anteile={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
traufe_feld={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
traufe_maske={
"type": "sampler2D",
"value": ""
}

[rendering]

rendering_device/driver.windows="vulkan"

anti_aliasing/quality/screen_space_aa=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
