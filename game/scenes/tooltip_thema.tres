[gd_resource type="Theme" format=3]

; Das Thema der Tooltips (Fehlerpaket 1, 14.11.2026; UI-Umbau „Zunftlade“, Teil 2: Holztafel). Aussehen steht NUR hier, Logik in scripts/Tooltips.cs.
; Pseudo-Typen: TooltipTafel (Fläche), TooltipFarben, TooltipMasse. „wert“ färbt die mit {{…}} markierten Zahlen (WoW-Stil).
; Die Tafel ist das Holz der Lade (gekachelt, grund_kachel Einheiten je Kachel) unter einem dunklen Schleier (eine Farbe, kein Verlauf) mit einer
; schlichten Kante je Seite; der festgeheftete Hinweis hat die Kante in Gold (kante_fest). Kein Schatten.

[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/holz.webp" id="1_holz"]

[sub_resource type="StyleBoxEmpty" id="Tafel"]
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 11.0

