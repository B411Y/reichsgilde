[gd_resource type="Theme" load_steps=3 format=3]

; Das Thema der Tooltips (Fehlerpaket 1, 14.11.2026). Aussehen steht NUR hier, Logik in scripts/Tooltips.cs.
; Pseudo-Typen: TooltipTafel (Flächen), TooltipFarben, TooltipMasse. „wert“ färbt die mit {{…}} markierten Zahlen (WoW-Stil).

[sub_resource type="StyleBoxFlat" id="TafelLose"]
bg_color = Color(0.12, 0.11, 0.1, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.82, 0.45, 0.7)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 6
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 10.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="TafelFest"]
bg_color = Color(0.12, 0.11, 0.1, 0.97)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.95, 0.82, 0.45, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 10
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 10.0
content_margin_bottom = 10.0

[resource]
TooltipTafel/styles/lose = SubResource("TafelLose")
TooltipTafel/styles/fest = SubResource("TafelFest")
TooltipFarben/colors/gold = Color(0.95, 0.82, 0.45, 1)
TooltipFarben/colors/hell = Color(0.92, 0.88, 0.8, 1)
TooltipFarben/colors/verweis = Color(0.941, 0.816, 0.439, 1)
TooltipFarben/colors/wert = Color(0.55, 0.85, 0.45, 1)
TooltipMasse/constants/schrift = 16
TooltipMasse/constants/titel = 20
TooltipMasse/constants/breite = 340
