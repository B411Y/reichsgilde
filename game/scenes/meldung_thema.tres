[gd_resource type="Theme" load_steps=8 format=3]

; Das Thema der Meldungen (Siegel-Ecke, Knopf „Verlauf“, zentrale Einblendung neuer Meldungen). Aussehen und Zeiten stehen NUR hier, Logik in Siegelecke.cs / EinblendungAnzeige.cs / Hauptszene.Meldungen.cs / MeldungStil.cs.
; Stil: Pergament mit schwarzem Umriss und leicht versetztem Schatten wie Brief und Siegel (kolorierter Holzschnitt).
; Typ-Varianten (Meldung…) erben von einem Godot-Typ; Maße der Familie stehen unter dem Pseudo-Typ MeldungMasse.

[ext_resource type="FontFile" path="res://assets/oberflaeche/schriften/GermaniaOne-Regular.ttf" id="1_titel"]

; ── Knopf „Verlauf“ an der Siegel-Ecke ──
[sub_resource type="StyleBoxFlat" id="VerlaufKnopf"]
bg_color = Color(0.9, 0.84, 0.68, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.09, 0.07, 0.05, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
shadow_color = Color(0, 0, 0, 0.45)
shadow_size = 1
shadow_offset = Vector2(3, 3)
content_margin_left = 10.0
content_margin_top = 3.0
content_margin_right = 10.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="VerlaufKnopfUeber"]
bg_color = Color(0.97, 0.9, 0.72, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.09, 0.07, 0.05, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
shadow_color = Color(0, 0, 0, 0.45)
shadow_size = 1
shadow_offset = Vector2(3, 3)
content_margin_left = 10.0
content_margin_top = 3.0
content_margin_right = 10.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxEmpty" id="Leer"]

; ── Zentrale Einblendung neuer Meldungen (Pergament, schwarzer Umriss, versetzter Schatten) ──
[sub_resource type="StyleBoxFlat" id="EinblendungSiegel"]
bg_color = Color(0.9, 0.84, 0.68, 0.97)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.09, 0.07, 0.05, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 2
shadow_offset = Vector2(6, 7)
content_margin_left = 18.0
content_margin_top = 12.0
content_margin_right = 22.0
content_margin_bottom = 12.0

[sub_resource type="StyleBoxFlat" id="EinblendungBrief"]
bg_color = Color(0.9, 0.84, 0.68, 0.97)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.09, 0.07, 0.05, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
shadow_color = Color(0, 0, 0, 0.5)
shadow_size = 2
shadow_offset = Vector2(7, 8)
content_margin_left = 24.0
content_margin_top = 16.0
content_margin_right = 28.0
content_margin_bottom = 16.0

[resource]
MeldungVerlaufKnopf/base_type = &"Button"
MeldungVerlaufKnopf/styles/normal = SubResource("VerlaufKnopf")
MeldungVerlaufKnopf/styles/hover = SubResource("VerlaufKnopfUeber")
MeldungVerlaufKnopf/styles/pressed = SubResource("VerlaufKnopfUeber")
MeldungVerlaufKnopf/styles/hover_pressed = SubResource("VerlaufKnopfUeber")
MeldungVerlaufKnopf/styles/focus = SubResource("Leer")
MeldungVerlaufKnopf/fonts/font = ExtResource("1_titel")
MeldungVerlaufKnopf/font_sizes/font_size = 15
MeldungVerlaufKnopf/colors/font_color = Color(0.09, 0.07, 0.05, 1)
MeldungVerlaufKnopf/colors/font_hover_color = Color(0.32, 0.12, 0.08, 1)
MeldungVerlaufKnopf/colors/font_pressed_color = Color(0.32, 0.12, 0.08, 1)
MeldungVerlaufKnopf/colors/font_hover_pressed_color = Color(0.32, 0.12, 0.08, 1)
; Platz, den die Siegel-Ecke rechts für den Knopf freihält
MeldungMasse/constants/verlauf_breite = 78
; ── Zentrale Einblendung: Tafel je Stufe (Siegel kleiner und kürzer, Brief größer und länger) ──
MeldungEinblendungSiegel/base_type = &"PanelContainer"
MeldungEinblendungSiegel/styles/panel = SubResource("EinblendungSiegel")
MeldungEinblendungBrief/base_type = &"PanelContainer"
MeldungEinblendungBrief/styles/panel = SubResource("EinblendungBrief")
MeldungEinblendungReihe/base_type = &"HBoxContainer"
MeldungEinblendungReihe/constants/separation = 16
MeldungEinblendungArtSiegel/base_type = &"Label"
MeldungEinblendungArtSiegel/fonts/font = ExtResource("1_titel")
MeldungEinblendungArtSiegel/font_sizes/font_size = 19
MeldungEinblendungArtSiegel/colors/font_color = Color(0.42, 0.12, 0.08, 1)
MeldungEinblendungArtBrief/base_type = &"Label"
MeldungEinblendungArtBrief/fonts/font = ExtResource("1_titel")
MeldungEinblendungArtBrief/font_sizes/font_size = 25
MeldungEinblendungArtBrief/colors/font_color = Color(0.42, 0.12, 0.08, 1)
MeldungEinblendungTextSiegel/base_type = &"Label"
MeldungEinblendungTextSiegel/font_sizes/font_size = 18
MeldungEinblendungTextSiegel/colors/font_color = Color(0.09, 0.07, 0.05, 1)
MeldungEinblendungTextBrief/base_type = &"Label"
MeldungEinblendungTextBrief/font_sizes/font_size = 21
MeldungEinblendungTextBrief/colors/font_color = Color(0.09, 0.07, 0.05, 1)
; Maße (Pixel) und Zeiten (Millisekunden) der Einblendung
MeldungMasse/constants/einblendung_breite_siegel = 460
MeldungMasse/constants/einblendung_breite_brief = 580
MeldungMasse/constants/einblendung_siegel_siegel = 64
MeldungMasse/constants/einblendung_siegel_brief = 84
MeldungMasse/constants/einblendung_zeilen = 3
MeldungMasse/constants/einblendung_abstand_unten = 24
MeldungMasse/constants/einblendung_einblenden_ms = 350
MeldungMasse/constants/einblendung_stehen_siegel_ms = 2500
MeldungMasse/constants/einblendung_stehen_brief_ms = 4000
MeldungMasse/constants/einblendung_wandern_ms = 700
MeldungMasse/constants/einblendung_endgroesse_prozent = 20
MeldungMasse/constants/einblendung_hoechstens_wartend = 4
; ── 3D-Schriftrollen der Meldungsleiste (SchriftrollenBuehne.cs, Szene schriftrolle_buehne.tscn) ──
; Platz je Rolle im Bild (Pixel bei 1600 × 900; größer als das Feld in der Leiste, damit der Sprung nicht abgeschnitten wird),
; Sichtfeld je Platz (Millimeter der Bühne; kleiner = Rolle größer), Zahl der Plätze der gemeinsamen Bühne, Überabtastung des Bildes
MeldungMasse/constants/rolle_zelle = 104
MeldungMasse/constants/rolle_sicht_mm = 760
MeldungMasse/constants/rolle_plaetze = 12
MeldungMasse/constants/rolle_abtastung_prozent = 150
; Neigung schräg nach oben zum Spieler und Drehen nach links und rechts im Leerlauf (Grad; Drehen höchstens 2, nur um die Hochachse),
; Sprung beim Erscheinen (Millimeter, Millisekunden), Ausblenden am Ende des Zurollens, Symbol sichtbar ab bzw. bis (Zeit des Modells)
MeldungMasse/constants/rolle_neigung_grad = 14
MeldungMasse/constants/rolle_pendel_grad = 2
MeldungMasse/constants/rolle_huepfen_mm = 70
MeldungMasse/constants/rolle_huepfen_ms = 260
MeldungMasse/constants/rolle_ausblenden_ms = 150
MeldungMasse/constants/rolle_symbol_ms = 233
; Vergrößerung unter der Maus (Prozent), Rand des Symbols (Prozent der Symbolfläche)
MeldungMasse/constants/rolle_ueber_prozent = 106
MeldungMasse/constants/rolle_symbol_rand_prozent = 17
; ── Kleiner 3D-Faltbrief der Meldungsleiste (SchriftrollenBuehne.cs mit Modell Brief, brief_klein.glb, Szene schriftrolle_buehne.tscn) ──
; Platz je Brief im Bild (Pixel bei 1600 × 900), Sichtfeld je Platz (Millimeter; der Brief ist 121 mm breit), Plätze, Überabtastung
MeldungMasse/constants/brief_zelle = 104
MeldungMasse/constants/brief_sicht_mm = 225
MeldungMasse/constants/brief_plaetze = 12
MeldungMasse/constants/brief_abtastung_prozent = 200
; Neigung nach oben zum Spieler, Drehen im Leerlauf (Grad; höchstens 2, nur um die Hochachse), Sprung beim Erscheinen (Millimeter, Millisekunden),
; Ausblenden beim Weggehen (ohne Sprung), Vergrößerung unter der Maus
MeldungMasse/constants/brief_neigung_grad = 12
MeldungMasse/constants/brief_pendel_grad = 2
MeldungMasse/constants/brief_huepfen_mm = 22
MeldungMasse/constants/brief_huepfen_ms = 260
MeldungMasse/constants/brief_ausblenden_ms = 180
MeldungMasse/constants/brief_ueber_prozent = 106
; Wachssiegel: Vergrößerung um seine Mitte (Prozent; 100 = wie im Modell), Abdunklung des eingedrückten Zeichens gegen das Wachs (Prozent)
MeldungMasse/constants/brief_siegel_prozent = 175
MeldungMasse/constants/brief_praegung_prozent = 60
; ── Großer 3D-Brief (BriefAnzeige.cs, BriefBuehne.cs, brief_gross.glb, Szene brief_buehne.tscn) ──
; Breite der 2D-Tafel = Breite der Inhaltsfläche des Blatts (Pixel bei 1600 × 900; das Blatt ist um 2 × 2 cm breiter, also 30/26 davon),
; Innenabstand der Tafel, freier Rand des Bildes um das Blatt (Millimeter; Platz für Umriss, Nachfedern und die Siegelhälften),
; Abstand des gestreckten Blatts zum Fensterrand, Überabtastung des 3D-Bildes
MeldungMasse/constants/brief_gross_breite = 372
MeldungMasse/constants/brief_gross_innen = 8
MeldungMasse/constants/brief_gross_rand_mm = 60
MeldungMasse/constants/brief_gross_fensterrand = 10
MeldungMasse/constants/brief_gross_abtastung_prozent = 100
; Einblenden am Anfang des Auffaltens und Ausblenden am Ende des Zufaltens (Millisekunden); Inhalt als Bild auf der Inhaltsfläche:
; beim Auffalten ab, beim Zufalten bis (Zeiten des Modells, docs/bereiche/darstellung.md)
MeldungMasse/constants/brief_gross_einblenden_ms = 100
MeldungMasse/constants/brief_gross_ausblenden_ms = 150
MeldungMasse/constants/brief_gross_inhalt_ab_ms = 733
MeldungMasse/constants/brief_gross_inhalt_bis_ms = 67
; ── Siegelstempel (SiegelstempelBuehne.cs, siegelstempel.glb, Szene siegelstempel_buehne.tscn) ──
; Kantenlänge des Bildes (Pixel bei 1600 × 900), Überabtastung des 3D-Bildes (Prozent), wie lange das fertige Siegel stehen bleibt und
; das Ausblenden danach (Millisekunden); Aufhellung des Wachstons unter dem Wappen des Abdrucks (Prozent; die Farben des Wappens liegen
; darüber und dunkeln ihn je Feld verschieden ab, so bleibt das Wappen im Wachs lesbar)
MeldungMasse/constants/siegelstempel_groesse = 320
MeldungMasse/constants/siegelstempel_abdruck_hell_prozent = 35
MeldungMasse/constants/siegelstempel_abtastung_prozent = 150
MeldungMasse/constants/siegelstempel_halten_ms = 350
MeldungMasse/constants/siegelstempel_ausblenden_ms = 150
; Farben: Grund des Symbols (der Rand hat die Farbe der Meldungsart aus meldungen.json, die Tinte ist die der Siegel), Schleier einer gelesenen Rolle
MeldungRolle/colors/symbol_grund = Color(0.95, 0.9, 0.76, 1)
MeldungRolle/colors/gelesen = Color(0.72, 0.7, 0.66, 1)
