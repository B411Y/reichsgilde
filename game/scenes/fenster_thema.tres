[gd_resource type="Theme" format=3]

; Das Thema der Fenster und Tafeln (UI-Umbau „Zunftlade“, Teil 2): Rand aus Stein, Kopf aus Holz, Leib aus Pergament, Schrift in dunkler Tinte.
; Aussehen steht NUR hier (und im Thema der Lade, zunftlade_thema.tres): Stoffe, Farben, Schriften, Abstände, Maße. Die Brücke ist FensterStil.cs,
; angezogen wird es von Fensterkleid.cs (jede Tafel, die Fensterrahmen.Anmelden oder FensterStil.Bekleiden ruft).
; Eigene Datei, weil hier die GRUNDTYPEN (Label, Button, LineEdit …) für alles gesetzt sind, was auf dem Pergament liegt – im Thema der Lade
; stünden sie auch der Lade im Weg. Nur freie Texturen, keine Verläufe, keine Schatten.
; Pseudo-Typen: FensterTafel / FensterTafelKopf (Innenabstand ohne bzw. mit Kopf), FensterStoff (was Fensterkleid zeichnet), FensterKopf (Titel),
; FensterKreuz (runder Schließknopf), FensterMasse, FensterFarben (auch für die Umrechnung heller Farben in Tinte, FensterStil.Tinte).

[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/holz.webp" id="1_holz"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/rahmen.webp" id="3_rahmen"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/pergament.webp" id="5_pergament"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/fenster/knopf.webp" id="8_knopf"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/fenster/knopf_an.webp" id="9_knopf_an"]
[ext_resource type="FontFile" path="res://assets/oberflaeche/schriften/GermaniaOne-Regular.ttf" id="6_titel"]
[ext_resource type="FontFile" path="res://assets/oberflaeche/schriften/Alegreya-Variabel.ttf" id="7_text"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/symbole/schloss.svg" id="s_schloss"]
[ext_resource type="Texture2D" path="res://assets/oberflaeche/zunftlade/symbole/gefahr.svg" id="s_gefahr"]

; Alegreya fett (Gewicht 700, Ziffern in Versalhöhe und gleich breit); 2003265652 = „wght“, 1819178349 = „lnum“, 1953396077 = „tnum“
