[resource]
; ── Maße (Einheiten der Oberfläche) ──
; Lade: Breite höchstens (schmaler, wenn das Fenster schmaler ist) und Höhe; Porträt-Fach mit Abstand zum unteren Rand, Rand des Bogens
LadeMasse/constants/lade_breite = 1280
LadeMasse/constants/lade_hoehe = 210
LadeMasse/constants/portraet_breite = 232
LadeMasse/constants/portraet_hoehe = 214
LadeMasse/constants/portraet_unten = 44
LadeMasse/constants/portraet_rand = 14
LadeMasse/constants/portraet_luft = 10
LadeMasse/constants/namensschild_hoehe = 36
LadeMasse/constants/namensschild_unten = 5
LadeMasse/constants/wappen = 26
; Fächer: Mindestbreite eines Werte-Fachs, Spalten der Werte und der Befehle, Zeile eines Betriebs, Symbol der Ware
LadeMasse/constants/wertfach_breite = 100
LadeMasse/constants/werte_spalten = 2
LadeMasse/constants/befehl_spalten = 3
LadeMasse/constants/betrieb_hoehe = 44
LadeMasse/constants/betrieb_symbol = 32
; Zeitleiste: Breite mindestens, Abstand zum oberen Rand, Knöpfe
LadeMasse/constants/zeit_breite = 840
LadeMasse/constants/zeit_oben = 12
LadeMasse/constants/pause_breite = 104
LadeMasse/constants/tempo_breite = 52
; Was die übrige Oberfläche frei lässt: oben (Zeitleiste), unten (Lade)
LadeMasse/constants/kopf_hoehe = 140
LadeMasse/constants/leisten_hoehe = 218
; Meldungen (3D-Faltbriefe) rechts über der Lade, das Schild der Raumleiste links: Abstand zum unteren Rand, Einzug von der Kante der Lade
LadeMasse/constants/meldungen_unten = 216
LadeMasse/constants/meldungen_einzug = 30
LadeMasse/constants/schild_unten = 216
LadeMasse/constants/schild_einzug = 30
; ── Farben, die der Code beim Namen nennt ──
LadeFarben/colors/portraet_grund = Color(0.118, 0.106, 0.09, 1)
LadeFarben/colors/zeit_himmel = Color(0.09, 0.07, 0.05, 1)
