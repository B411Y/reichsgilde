[resource]
; ── Familie: Farben und Maße (abgefragt mit GetThemeColor/GetThemeConstant, Typ „RatFarben“ bzw. „RatMasse“) ──
RatFarben/colors/gold = Color(0.95, 0.82, 0.45, 1)
RatFarben/colors/grau = Color(0.72, 0.72, 0.72, 1)
RatFarben/colors/gruen = Color(0.55, 0.85, 0.5, 1)
RatFarben/colors/rot = Color(0.95, 0.45, 0.4, 1)
RatFarben/colors/schrift = Color(0.92, 0.88, 0.8, 1)
RatMasse/constants/text_breite = 670
RatMasse/constants/kammer_breite = 720

; ── Container ──
RatTafel/base_type = &"PanelContainer"
RatTafel/styles/panel = SubResource("Tafel")
RatKurzTafel/base_type = &"PanelContainer"
RatKurzTafel/styles/panel = SubResource("KurzTafel")
RatRand/base_type = &"MarginContainer"
RatRand/constants/margin_left = 22
RatRand/constants/margin_top = 22
RatRand/constants/margin_right = 22
RatRand/constants/margin_bottom = 22
RatSpalte/base_type = &"VBoxContainer"
RatSpalte/constants/separation = 8
RatZeile/base_type = &"HBoxContainer"
RatZeile/constants/separation = 10
RatRaster/base_type = &"GridContainer"
RatRaster/constants/h_separation = 14
RatRaster/constants/v_separation = 2

; ── Reiter ──
