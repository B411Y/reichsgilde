<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Simulationskern von Reichsgilde.
    WICHTIG: Dieses Projekt kennt Godot NICHT. Hier steckt die reine Spiellogik
    (Zeit, Wirtschaft, Bürger, Gesetze ...). So kann sie später unverändert auf
    einem Server laufen und lässt sich ohne Grafik testen.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Reichsgilde.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Die Tests dürfen auch interne Teile prüfen (z. B. Markt.NeueStunde). -->
    <InternalsVisibleTo Include="Reichsgilde.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Die Gen-Vorlage des Erbguts steckt im Kern selbst (Erbgutvorlage.Standard). Die Datei liegt bei den anderen Spieldaten
      in game/daten/, wird aber beim Bauen eingebettet: So braucht weder das Spiel noch ein Test einen Pfad dorthin.
    -->
    <EmbeddedResource Include="..\..\game\daten\erbgut.json" LogicalName="Reichsgilde.Core.erbgut.json" Link="Daten\erbgut.json" />
  </ItemGroup>
</Project>
